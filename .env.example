NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Opcional, somente ao migrar APP_URL: origens antigas exatas, separadas por vírgula.
# HTTPS em produção; sem barra final, caminhos ou curingas. Vazio preserva o fluxo atual.
# Após configurar https://webfidelize.com: https://webfidelize-saas.vercel.app
AUTH_LEGACY_ORIGINS=
NEXT_PUBLIC_WHATSAPP=5518997695445
# Apenas no servidor. disabled até homologar o webhook real e a integração.
# test usa exclusivamente o token de teste e NUNCA concede acesso pago.
BILLING_MODE=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_COLLECTOR_ID=
# Segredo da tela Webhooks; não é o Client Secret de OAuth.
MERCADO_PAGO_WEBHOOK_SECRET=
# Gere 32+ bytes exclusivos; configure somente SHA256 em private.billing_config.
BILLING_GATEWAY_SECRET=

# Segredo privado do gateway de reservas; configurar hash correspondente no banco.
BOOKING_GATEWAY_SECRET=

# Privado. Gere 32 bytes aleatórios; configure SHA256 em private.sales_gateway_config.
# Usado somente no servidor para captação comercial, independente das reservas.
SALES_GATEWAY_SECRET=

# Privado. Gere 32 bytes aleatórios (base64url); valida a sessão de recuperação.
AUTH_FLOW_SECRET=

# Opcional: envio de convites pela aplicação, somente com APP_URL HTTPS.
# Separado do SMTP que será configurado no painel Supabase para Auth.
# HOST/PORT/FROM são configuração; USER/PASSWORD nunca vão ao frontend.
TEAM_SMTP_HOST=
TEAM_SMTP_PORT=465
TEAM_SMTP_USER=
TEAM_SMTP_PASSWORD=
TEAM_SMTP_FROM=

# WhatsApp Cloud API: tudo privado, nunca prefixar com NEXT_PUBLIC_.
# Desabilitado até número/template aprovados, webhook e agendador configurados.
WHATSAPP_SEND_ENABLED=false
# Versão suportada da Graph API, configurada explicitamente (ex.: v24.0).
WHATSAPP_GRAPH_VERSION=
# JSON array: [{"companyId":"UUID","phoneNumberId":"ID_META","accessToken":"TOKEN_PRIVADO","templateName":"lembrete_agendamento","languageCode":"pt_BR"}]
# Um número exclusivo por empresa. Configure apenas no ambiente do servidor.
WHATSAPP_CONNECTIONS_JSON=
# Para avisos da equipe, cada conexão também exige staffDailyTemplateName e
# staffNewAppointmentTemplateName (modelos pt_BR aprovados, nunca tokens no frontend).
WHATSAPP_APP_SECRET=
# Gere 32 bytes aleatórios para cada segredo abaixo; não reutilize entre eles.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GATEWAY_SECRET=
CRON_SECRET=

# Central IA interna: somente servidor. Na Vercel, AI Gateway usa OIDC automaticamente.
# Opcional apenas fora da Vercel; não use chaves de provedores diretamente no navegador.
AI_GATEWAY_API_KEY=
# Segredo exclusivo de 32+ bytes; seu SHA256 deve constar em private.platform_ai_gateway.
AI_WORKER_SECRET=
# CRON_SECRET acima autentica a rotina diária /api/admin-ai/process.
# Configuração e cotas por tentativas ficam em /admin/ia. Geração exige conta Gateway liberada.
